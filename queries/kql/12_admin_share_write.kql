SelbiADLab_CL
| where Channel == "Security" and Provider == "Microsoft-Windows-Security-Auditing"
| where EventID == 5145 and (ShareName endswith "\\ADMIN$" or ShareName endswith "\\C$") and (AccessMask in~ ("0x2", "0x3", "0x12019f", "0x100002")) and (RelativeTargetName endswith ".exe" or RelativeTargetName endswith ".dll" or RelativeTargetName endswith ".ps1" or RelativeTargetName endswith ".bat")
